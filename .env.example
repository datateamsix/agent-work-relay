AWR_ENV=local
AWR_AUTH_MODE=static
AWR_STATIC_TOKEN=local-dev-token
AWR_PUBLIC_BASE_URL=http://127.0.0.1:43145
AWR_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

AWR_STORAGE=sqlite
AWR_SQLITE_PATH=.awr/awr.db
AWR_ARTIFACT_ROOT=.awr/artifacts
AWR_ARTIFACT_MAX_BYTES=10485760
AWR_EXECUTOR=recording_cursor
AWR_REPOSITORY_URL=https://github.com/your-org/your-repo
AWR_BASE_REF=main

# Hosted production profile (never enable static tokens)
# AWR_ENV=production
# AWR_AUTH_MODE=oauth
# AWR_STORAGE=firestore
# AWR_EXECUTOR=cursor_cloud
# AWR_OAUTH_ISSUER=https://your-tenant.auth0.com/
# AWR_OAUTH_AUDIENCE=https://agent-work-relay-xxxxx.run.app/mcp
# AWR_OAUTH_JWKS_URL=https://your-tenant.auth0.com/.well-known/jwks.json
# AWR_PUBLIC_BASE_URL=https://agent-work-relay-xxxxx.run.app
# GOOGLE_CLOUD_PROJECT=modelready-m3
# FIRESTORE_DATABASE=(default)
# CURSOR_API_BASE_URL=https://api.cursor.com
# CURSOR_API_KEY=

# Real Cursor Cloud adapter: set AWR_EXECUTOR=cursor_cloud
CURSOR_API_BASE_URL=https://api.cursor.com
CURSOR_API_KEY=

# Alternative stores (Supabase/Postgres is not implemented in this slice)
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE=
SUPABASE_DATABASE_URL=
